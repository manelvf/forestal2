[flake8]
max-line-length = 127
exclude =
    .git,
    __pycache__,
    */migrations/*,
    */venv/*,
    */env/*,
    */virtualenv/*,
    node_modules/,
    staticfiles/,
    media/

ignore =
    # E501: line too long (handled by max-line-length)
    E501,
    # W503: line break before binary operator (conflict with black)
    W503,
    # E203: whitespace before ':' (conflict with black)
    E203

per-file-ignores =
    # Ignore import order in __init__.py files
    __init__.py:F401
    # Ignore unused imports in settings
    settings.py:F401,F403
    settings.example.py:F401,F403
